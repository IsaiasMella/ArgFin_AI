# Copiá este archivo a .env y completá los valores. Nunca subas .env al repositorio.
# Todas las variables son obligatorias salvo las marcadas como (opcional).
# Una variable vacía cuenta como faltante: la app no arranca y lista cuáles faltan.

# App
# APP_ENV: development | test | staging | production
APP_ENV=
APP_BASE_URL=
WEB_BASE_URL=
COOKIE_DOMAIN=
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=
# Zona horaria IANA de los cron, p. ej. America/Argentina/Buenos_Aires
APP_TIMEZONE=

# Base de datos (postgresql+psycopg://usuario:clave@host:5432/base)
# Con Docker Compose el host es "postgres" (el nombre del servicio).
# DATABASE_URL usa el rol de la app (POSTGRES_APP_USER), sujeto a RLS.
# DATABASE_URL_MIGRATIONS usa el rol de migraciones (POSTGRES_MIGRATOR_USER), dueño del esquema.
DATABASE_URL=
DATABASE_URL_MIGRATIONS=

# Seguridad
# Secretos de al menos 32 caracteres:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
CSRF_SECRET=
# Clave AES-256 (32 bytes en base64 URL-safe):
#   uv run python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
# (opcional) Claves anteriores separadas por coma, solo durante una rotación (docs/adr/008)
FIELD_ENCRYPTION_KEYS_PREVIOUS=
# Emails separados por coma que reciben el rol admin al ingresar
ADMIN_EMAILS=
# Duración de la sesión en horas (máximo 720), p. ej. 168 = 7 días
SESSION_TTL_HOURS=
# Pedidos por minuto y por IP a los endpoints de ingreso, p. ej. 20
RATE_LIMIT_AUTH_PER_MINUTE=
# Cargas de CSV por hora y por sesión, p. ej. 10
RATE_LIMIT_UPLOAD_PER_HOUR=

# Carga de portafolio por CSV: tamaño máximo en bytes (p. ej. 65536) y filas (p. ej. 200)
CSV_MAX_BYTES=
CSV_MAX_ROWS=

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Documento de descubrimiento OIDC: https://accounts.google.com/.well-known/openid-configuration
GOOGLE_DISCOVERY_URL=

# LLMs (nombres de modelo según LiteLLM)
LLM_EXTRACTION_MODEL=
# (opcional)
LLM_EXTRACTION_FALLBACK_MODEL=
LLM_CLASSIFICATION_MODEL=
LLM_WRITER_MODEL=
# p. ej. text-embedding-3-large
LLM_EMBEDDING_MODEL=
# Máximo 2000 (límite de índices de pgvector), p. ej. 1536
LLM_EMBEDDING_DIMENSIONS=
LLM_JUDGE_MODEL=
# Claves de los proveedores: solo las de los modelos que configures arriba (prefijo
# anthropic/, openai/ o gemini/). La de Gemini se saca en aistudio.google.com.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MONTHLY_BUDGET_USD=

# Observabilidad
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Fuentes de datos
# La SEC exige nombre y email de contacto, p. ej. "Brujula contacto@ejemplo.com"
SEC_USER_AGENT=
# Precios (docs/adr/011). Valores públicos:
#   BYMA_OPEN_DATA_BASE_URL=https://open.bymadata.com.ar/vanoms-be-core/rest/api/bymadata/free
#   DATA912_BASE_URL=https://data912.com
BYMA_OPEN_DATA_BASE_URL=
DATA912_BASE_URL=
PRICE_DIVERGENCE_THRESHOLD_PCT=
# Documentos de empresas (docs/adr/013). Valores públicos:
#   CNV_BASE_URL=https://www.cnv.gov.ar/SitioWeb
#   CNV_AIF_BASE_URL=https://aif2.cnv.gov.ar
#   CNV_BLOB_BASE_URL=https://blob.cnv.gov.ar/BlobWebService.svc
#   SEC_DATA_BASE_URL=https://data.sec.gov
#   SEC_ARCHIVES_BASE_URL=https://www.sec.gov
CNV_BASE_URL=
CNV_AIF_BASE_URL=
CNV_BLOB_BASE_URL=
SEC_DATA_BASE_URL=
SEC_ARCHIVES_BASE_URL=

# Programación de tareas (cron de 5 campos, en APP_TIMEZONE)
CRON_PRICES_DAILY=
CRON_FILINGS_CHECK=
CRON_NEWS_INGEST=
CRON_WEEKLY_DIGEST=

# Email
# API de Resend (https://api.resend.com). Envía los avisos del monitor a ADMIN_EMAILS (T3.7).
RESEND_API_BASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Negocio
PRICE_PRO_ARS=
FREE_PLAN_MAX_POSITIONS=
FREE_PLAN_DIGESTS_PER_MONTH=
# true durante el MVP: todo usuario nuevo queda con plan fundador
FOUNDER_PLAN_OPEN=
# (opcional hasta T9.1)
VALIDATION_THRESHOLD_PCT=

# Pagos (fase 9; opcionales hasta entonces)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Almacenamiento y rutas
# Documentos descargados. Con Docker Compose: /app/data/documents (volumen `documents`).
DOCUMENT_STORAGE_DIR=
# Carpeta de config/*.yaml (universo, umbrales). Relativa al directorio de trabajo: ./config
CONFIG_DIR=
PROMPTS_DIR=

# --- Docker Compose ----------------------------------------------------------
# Estas variables no las lee la app: las usa docker/compose.yml.
# Superusuario de PostgreSQL: solo crea roles y extensiones al inicializar el volumen.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Roles creados por docker/postgres-init (deben coincidir con las URLs de arriba).
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_USER=
POSTGRES_MIGRATOR_PASSWORD=
# "http://localhost" en desarrollo; el dominio de la API en producción (TLS automático)
CADDY_SITE_ADDRESS=
