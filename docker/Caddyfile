# CADDY_SITE_ADDRESS: "http://localhost" en desarrollo (sin TLS) o el dominio de la API
# en producción (p. ej. "api.ejemplo.com"), con certificado TLS automático.
{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	# Ningún pedido legítimo es más grande (el CSV de portafolio pesa unos KB).
	request_body {
		max_size 2MB
	}
	reverse_proxy api:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
